# Copy to .env in the development deployment directory on the Non-Prod server.
# Do not reuse the production database or AUTH_SECRET.
WEBSITE_PORT=3002
DATABASE_URL=mysql://dev_user:replace-me@database-host:3306/narrativeos_dev
AUTH_SECRET=replace-with-a-separate-long-random-development-secret
AUTH_COOKIE_SECURE=false

# SMTP may reuse an approved test mailbox, or stay empty until mail testing is needed.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://YOUR_SERVER_IP:3002/api/auth/wechat/callback
