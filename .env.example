DATABASE_URL="mysql://user:password@127.0.0.1:3306/narrativeos"
AUTH_SECRET="replace-with-a-long-random-string"
# Empty follows NODE_ENV: false in local development, true in production.
# Set false explicitly only for an HTTP Non-Prod server.
AUTH_COOKIE_SECURE=""
NEXT_PUBLIC_WORKBENCH_URL="https://www.narrativeos.cn/narrativeos/"
# Must match TEACHER_ECOSYSTEM_SERVICE_TOKEN in the generation backend.
TEACHER_ECOSYSTEM_SERVICE_TOKEN="replace-with-a-separate-long-random-string"

SMTP_HOST="smtpdm.aliyun.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# Reserved for WeChat login
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECHAT_REDIRECT_URI="https://www.narrativeos.cn/api/auth/wechat/callback"
