generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  email
  wechat
}

enum TeacherWorkStatus {
  PUBLISHED
  ARCHIVED
}

model User {
  id              String        @id @default(cuid())
  email           String?       @unique
  emailVerifiedAt DateTime?     @map("email_verified_at")
  nickname        String?
  avatarUrl       String?       @map("avatar_url")
  passwordHash    String?       @map("password_hash")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  accounts        Account[]
  sessions        AuthSession[]
  teacherProfile  TeacherProfile?
  teacherWorks    TeacherWork[]

  @@map("users")
}

model TeacherProfile {
  userId      String   @id @map("user_id")
  displayName String?  @map("display_name")
  bio         String?  @db.Text
  isSeed      Boolean  @default(true) @map("is_seed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model TeacherWork {
  id            String            @id @default(cuid())
  jobId         String            @unique @map("job_id") @db.VarChar(32)
  authorId      String            @map("author_id")
  title         String            @db.VarChar(160)
  summary       String?           @db.Text
  coverUrl      String?           @map("cover_url") @db.VarChar(1024)
  playUrl       String            @map("play_url") @db.VarChar(1024)
  quizUrl       String?           @map("quiz_url") @db.VarChar(1024)
  subject       String?           @db.VarChar(80)
  grade         String?           @db.VarChar(80)
  tags          Json?
  status        TeacherWorkStatus @default(PUBLISHED)
  featured      Boolean           @default(false)
  publishedAt   DateTime          @default(now()) @map("published_at")
  unpublishedAt DateTime?         @map("unpublished_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  author        User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status, publishedAt])
  @@index([authorId, status])
  @@index([title])
  @@map("teacher_works")
}

model Account {
  id                String       @id @default(cuid())
  userId            String       @map("user_id")
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  unionId           String?      @map("union_id")
  profileJson       Json?        @map("profile_json")
  createdAt         DateTime     @default(now()) @map("created_at")
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model VerificationCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("verification_codes")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}
